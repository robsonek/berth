set -euo pipefail
umask 077
exec >>{{ .LogFile }} 2>&1
exec 9>{{ .LockFile }}
flock -n 9 || { echo "[$(date -u +%FT%TZ)] berth offsite: skipped (another run holds the lock)"; exit 0; }
exec 8>{{ .ArtifactsLock }}
flock -w 900 8 || { echo "[$(date -u +%FT%TZ)] berth offsite: giving up (local backups still running after 15m)"; exit 1; }
echo "[$(date -u +%FT%TZ)] berth offsite: start"
set -a
. {{ .EnvFile }}
set +a
restic{{ .ResticOpts }} backup {{ .BackupBaseDir }} --host {{ .HostID }} --exclude '.tmp-*' --exclude '.lock' --exclude '.artifacts.lock' --exclude '.offsite.lock'
restic{{ .ResticOpts }} forget --prune --keep-daily {{ .KeepDaily }} --keep-weekly {{ .KeepWeekly }} --keep-monthly {{ .KeepMonthly }}
echo "[$(date -u +%FT%TZ)] berth offsite: done"
