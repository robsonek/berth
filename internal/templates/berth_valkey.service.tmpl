[Unit]
Description=Valkey{{ if .Queue }} queue{{ end }} for {{ .Domain }} (berth)
After=network.target

[Service]
Type=notify
User={{ .User }}
Group={{ .User }}
RuntimeDirectory=berth-valkey/{{ .Pool }}
RuntimeDirectoryMode=0700
{{ if .Preserve }}RuntimeDirectoryPreserve=yes
{{ end }}StateDirectory=berth-valkey/{{ .Pool }}{{ .StateSuffix }}
StateDirectoryMode=0700
ExecStart=/usr/bin/valkey-server --port 0 --unixsocket /run/berth-valkey/{{ .Pool }}/{{ .SocketName }} --unixsocketperm 600 --dir /var/lib/berth-valkey/{{ .Pool }}{{ .StateSuffix }} --maxmemory {{ .Maxmemory }} --maxmemory-policy {{ .Policy }}{{ if .Queue }} --appendonly yes --appendfsync everysec{{ end }} --supervised systemd --daemonize no
Restart=always
TimeoutStopSec=infinity

[Install]
WantedBy=multi-user.target
